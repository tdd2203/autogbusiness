# Copy file này thành `.env` ở thư mục gốc rồi điền giá trị thật.
# docker compose tự đọc `.env` này để thay ${VAR}.

# --- Postgres ---
# Đổi khác mặc định nếu chạy production (team truy cập từ xa).
POSTGRES_PASSWORD=doi-mat-khau-manh

# --- JWT --- generate: openssl rand -hex 32
JWT_SECRET=__THAY_BANG_64_HEX_NGAU_NHIEN__

# --- Super-admin seed (chỉ dùng lần đầu khi DB rỗng) ---
# Đổi password ngay sau khi login lần đầu (Cài đặt → Đổi mật khẩu).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=__MAT_KHAU_MANH_MIN_12_KY_TU__

# --- URL công khai team truy cập (dùng cho CORS) ---
# Vd: https://gpt.ten-mien-cua-ban.com
PUBLIC_URL=https://gpt.ten-mien-cua-ban.com

# --- Cloudflare Tunnel token ---
# Lấy ở: Cloudflare Zero Trust → Networks → Tunnels → tạo tunnel → copy token.
# Chỉ cần khi chạy với `--profile remote`.
CF_TUNNEL_TOKEN=__DAN_TUNNEL_TOKEN__

# --- Ví & SePay (feature 003-wallet-invite-payment) ---
# SEPAY_APIKEY: khớp header webhook "Authorization: Apikey <key>" trong SePay
# dashboard. Rỗng = webhook không auth (chỉ demo local). Prod PHẢI set.
SEPAY_APIKEY=
SEPAY_SECRET_KEY=
# Phí mời mặc định (VND) khi seed lần đầu; sửa runtime trong UI admin Ví.
WALLET_INVITE_FEE_DEFAULT=100000
# Tài khoản test bật sẵn cờ Ví để xem trước. Để trống WALLET_TEST_PASSWORD =
# KHÔNG tạo tài khoản test. Đặt mật khẩu mạnh (≥12 ký tự) để bật demo.
WALLET_TEST_USERNAME=wallet_tester
WALLET_TEST_PASSWORD=

# ---- Gửi email OTP đăng ký (ủy thác cho dự án HostMail qua API) ----
# HOSTMAIL_API_BASE rỗng = CHẾ ĐỘ DEV: OTP in ra log thay vì gửi thật (test không
# cần HostMail). Điền base URL để gửi thật, ví dụ https://tempmail.lovevn.org/api/v1
HOSTMAIL_API_BASE=
HOSTMAIL_API_KEY=
# Đường dẫn endpoint gửi trên HostMail (nối vào API_BASE). Mặc định /send.
HOSTMAIL_SEND_PATH=/send
# Địa chỉ + tên hiển thị "From". Để trống HOSTMAIL_FROM = HostMail dùng
# noreply@<domain mặc định của nó>. Domain phải thuộc quyền của API key.
HOSTMAIL_FROM=
HOSTMAIL_FROM_NAME=AutoGPT Dashboard
# Tham số OTP (mặc định hợp lý; đổi nếu cần).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ---- Nhắc gia hạn tự động qua Telegram (feature 004) ----
# TELEGRAM_BOT_TOKEN rỗng = TẮT HẲN tính năng (job nền không chạy, endpoint trả 503).
# Lấy token bằng cách chat với @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=
# @username của bot (không có '@'). Bỏ trống = server tự hỏi Telegram (getMe).
TELEGRAM_BOT_USERNAME=
# Secret webhook: đặt chuỗi ngẫu nhiên dài, server so với header
# X-Telegram-Bot-Api-Secret-Token của Telegram. PROD PHẢI SET.
TELEGRAM_WEBHOOK_SECRET=
# Group/kênh nhận BẢN TỔNG HỢP hằng ngày. ID group thường ÂM (-100...). Lấy bằng
# cách thêm bot vào group rồi gõ /id. Nhiều đích: ngăn cách bằng dấu phẩy. Rỗng = tắt digest.
TELEGRAM_ADMIN_CHAT_ID=
# Mốc nhắc trước hạn (số ngày còn lại) + giờ gửi theo giờ VN.
RENEWAL_REMINDER_DAYS=3,1
RENEWAL_REMINDER_HOUR=9
RENEWAL_REMINDER_UTC_OFFSET=7

# ---- Giới hạn RAM (tối ưu 2026-08-04) ----
# Tất cả đều CÓ MẶC ĐỊNH hợp lý cho VPS 2GB — chỉ điền khi cần nới/siết.
#
# Trần RAM mỗi container (docker-compose.yml). Chạm trần = container bị OOM-kill
# rồi `restart: always` dựng lại, thay vì kéo sập cả VPS. Kiểm tra container nào
# đang sát trần:  docker stats --no-stream
# API_MEM_LIMIT=768m
# PG_MEM_LIMIT=384m
# WEB_MEM_LIMIT=64m
# CF_MEM_LIMIT=192m
#
# Pool kết nối DB + threadpool của API (apps/api/app/config.py). Mỗi kết nối là
# một backend process phía Postgres. DB_POOL_SIZE + DB_MAX_OVERFLOW PHẢI nhỏ hơn
# max_connections=30 khai báo trong docker-compose.yml.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# THREAD_POOL_SIZE=16
